# ThermoSafe settings for thermo_server.py.
# Copy this file to .env (same folder) and fill it in. Git ignores .env, so keys and phone numbers never reach GitHub.

# Twilio (console.twilio.com): Account SID, Auth Token, and your Twilio number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+14135550100

# The phone that rings when that worker's clip goes offline (B5 = Dev, the "Dev's clip glitches" demo).
# On a Twilio trial account this number must be a Verified Caller ID.
DEMO_CALL_B5=+15555550123

# Gemini (aistudio.google.com): writes each call and understands spoken answers
GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-3.7-flash

# Key presses: leave PUBLIC_URL empty and the server opens a free Cloudflare tunnel itself
# (install once: winget install --id Cloudflare.cloudflared). Set it only if you run your own tunnel.
# PUBLIC_URL=https://xxxx.trycloudflare.com
# CLOUDFLARED=C:\path\to\cloudflared.exe
# TUNNEL=off

# Seconds of silence before a real clip counts as offline
# OFFLINE_AFTER=4
