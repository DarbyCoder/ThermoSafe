# Generate separate random values for these two keys. Neither may be blank.
THERMOSAFE_DEVICE_KEY=replace-with-a-random-device-key
THERMOSAFE_DASHBOARD_KEY=replace-with-a-different-random-dashboard-key
THERMOSAFE_DB=data/thermosafe.sqlite3
# Tiger Cloud PostgreSQL connection URI. Keep this secret in .env, never firmware.
THERMOSAFE_TIGERDATA_DSN=
# Comma-separated exact origins. Add the URL used by your teammate's interface.
THERMOSAFE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
THERMOSAFE_OFFLINE_SECONDS=20
THERMOSAFE_ALLOW_SIMULATOR=true
# Dashboard bridge: the key below must match THERMOSAFE_DASHBOARD_KEY above.
THERMOSAFE_API_URL=http://127.0.0.1:8000
# Twilio/Gemini are optional until real phone calls are enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PUBLIC_URL=
TUNNEL=off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optional recipient overrides, for example DEMO_CALL_B1=+14155550123
# Site-level weather and UV forecast location (UMass Amherst demo defaults).
THERMOSAFE_WEATHER_LOCATION_NAME=UMass Amherst
THERMOSAFE_WEATHER_LATITUDE=42.3912
THERMOSAFE_WEATHER_LONGITUDE=-72.5262
